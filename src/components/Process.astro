---
import steps from '../data/process.json';
---
<section class="section" id="proceso" aria-labelledby="proceso-title">
  <div class="container">
    <h2 id="proceso-title" class="section-title" data-reveal="left">Cómo trabajamos</h2>

    <ol class="steps">
      {steps.map((s, i) => (
        <li data-reveal="up" data-delay={i ? String(i) : undefined}>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none; counter-reset: step;
    margin-top: 56px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px;
  }
  .steps li { counter-increment: step; }
  .steps li::before {
    content: counter(step); display: block; margin-bottom: 14px;
    font-size: 3rem; font-weight: 800; font-stretch: 75%; line-height: 1; color: var(--brand);
  }
  .steps h3 { font-size: 1.15rem; font-weight: 700; margin-bottom: 6px; }
  .steps p { color: var(--muted); }

  @media (max-width: 760px) {
    .steps { grid-template-columns: 1fr; gap: 36px; margin-top: 36px; }
  }
</style>
